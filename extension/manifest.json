{
  "manifest_version": 3,
  "name": "ApplyPilot",
  "version": "0.2.0",
  "description": "Remplit tes candidatures (Workday & co.) et rédige des lettres de motivation sur mesure. 100 % local, avec ton serveur ApplyPilot.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ApplyPilot — ouvrir le panneau",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content/dom.js",
        "content/extract.js",
        "content/fields.js",
        "content/widgets.js",
        "content/mapping.js",
        "content/workday.js",
        "content/main.js"
      ]
    }
  ]
}
