{
  "manifest_version": 3,
  "name": "ApplyPilot",
  "version": "0.4.0",
  "description": "Local-first job application assistant: Workday autofill, tailored cover letters via pi, and tracking. English / Français UI.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ApplyPilot — open side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "i18n.js",
        "content/dom.js",
        "content/extract.js",
        "content/fields.js",
        "content/widgets.js",
        "content/mapping.js",
        "content/workday.js",
        "content/main.js"
      ]
    }
  ]
}
