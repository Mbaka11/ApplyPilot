{
  "name": "applypilot-server",
  "version": "0.3.0",
  "private": true,
  "description": "Serveur local d'ApplyPilot : profil, CV, lettres de motivation (via pi) et journal des candidatures.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node ../tests/server.test.mjs && node ../tests/content.test.mjs && node ../tests/e2e.test.mjs",
    "test:server": "node ../tests/server.test.mjs",
    "test:content": "node ../tests/content.test.mjs",
    "test:e2e": "node ../tests/e2e.test.mjs",
    "icons": "node ../scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "puppeteer-core": "^25.13.0",
    "yaml": "^2.9.1"
  }
}
